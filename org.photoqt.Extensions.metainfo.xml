    <releases>
        <release version="5.4" date="2026-06-24">
            <description>
                <ul>
                    <li>adapt to changes in extended extensions API</li>
                    <li>remove various no longer needed C++ methods</li>
                    <li>improve export image also reacts to return key</li>
                    <li>touch up thumbnail generator with minor visual improvements</li>
                    <li>requires PhotoQt v5.4+</li>
                </ul>
            </description>
            <url>
                https://photoqt.org/news/photoqt-5.4
            </url>
        </release>
        <release version="5.3" date="2026-05-11">
            <description>
                <ul>
                    <li>add: ThumbnailGenerator extension</li>
                    <li>improve: extend verification process to also include libraries (see README)</li>
                    <li>improve: reworked python script for generating verifications</li>
                    <li>improve: better handling of install prefix, including configure options for subfolder</li>
                    <li>improve: localize also entries in manifest</li>
                    <li>change: bump target API level to 2, requires PhotoQt 5.3 or later</li>
                </ul>
            </description>
            <url>
                https://photoqt.org/news/photoqt-5.3
            </url>
        </release>
        <release version="5.2" date="2026-02-20">
            <description>
                <ul>
                    <li>CropImage: harden how info between QML and CPP is passed</li>
                    <li>ExportImage: don't attemp exporting with no format selected to avoid crash</li>
                    <li>ExportImage: harden how info between QML and CPP is passed</li>
                    <li>ScaleImage: fix setting font properties for buttons</li>
                </ul>
            </description>
            <url>
                https://photoqt.org/news/photoqt-5.2
            </url>
        </release>
        <release version="5.1" date="2026-01-16">
            <description>
                <ul>
                    <li>add: cmake options to disable individual extensions during build</li>
                    <li>improve: install instructions</li>
                    <li>fix: building with GraphicsMagick</li>
                </ul>
            </description>
            <url>
                https://photoqt.org/news/photoqt-5.1
            </url>
        </release>
        <release version="5.0" date="2025-12-23">
            <description>
                <ul>
                    <li>first release of extensions, extracted from code previously integrated in PhotoQt</li>
                </ul>
            </description>
            <url>
                https://photoqt.org/news/photoqt-5.0
